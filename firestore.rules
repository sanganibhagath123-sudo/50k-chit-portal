rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function currentLogin() {
      return hasProfile() &&
        get(/databases/$(database)/documents/members/$(myName())).data.uid == request.auth.uid;
    }
    function approved() {
      return currentLogin() &&
        get(/databases/$(database)/documents/members/$(myName())).data.status == 'approved';
    }
    function coPerm(perm) {
      return approved() &&
        exists(/databases/$(database)/documents/shared/coadmins) &&
        get(/databases/$(database)/documents/shared/coadmins).data.map
          .get(myName(), {}).get(perm, false) == true;
    }
    function staff(perm) { return isAdmin() || coPerm(perm); }
    function isOwner(name) { return currentLogin() && myName() == name; }
    function selfBoardKeys(changed) {
      return changed.hasOnly(['pay_' + myName(), 'sr_' + myName()])
        && (!(('pay_' + myName()) in changed) || request.resource.data['pay_' + myName()] == 'submitted')
        && (!(('sr_' + myName()) in changed) || request.resource.data['sr_' + myName()] == 'submitted');
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username'])
        && get(/databases/$(database)/documents/members/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /members/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == name
        && request.resource.data.status == 'pending'
        && (request.resource.data.role == 'member'
            || (request.resource.data.role == 'organizer' && name == 'bhagath'));
      allow update: if isAdmin()
        || (staff('members')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approvedAt', 'updatedAt', 'resetUntil'])
            && resource.data.role != 'organizer');
      allow update: if signedIn()
        && resource.data.role != 'organizer'
        && resource.data.get('resetUntil', 0) > request.time.toMillis()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('resetUntil', 0) == 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uid', 'resetUntil', 'updatedAt']);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }
    match /logins/{name} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'hasEmail', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/members/$(name)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /profiles/{name} {
      allow read: if isOwner(name) || isAdmin() || staff('members');
      allow write: if isOwner(name) || isAdmin();
    }
    match /payments/{name} {
      allow read: if isOwner(name) || staff('payments');
      allow create, update: if (isOwner(name) && approved()
            && request.resource.data.status == 'submitted'
            && (resource == null || resource.data.status != 'verified'))
        || (staff('payments') && (isAdmin() || name != myName()));
      allow delete: if staff('payments') || staff('auction');
    }
    match /passbook/{name} {
      allow read: if isOwner(name) || staff('payments');
      allow write: if staff('payments') && (isAdmin() || name != myName());
    }
    match /surety/{name} {
      allow read: if isOwner(name) || isAdmin();
      allow create, update: if (isOwner(name) && approved()
            && request.resource.data.status == 'submitted'
            && (resource == null || !(resource.data.status in ['verified', 'released'])))
        || isAdmin();
      allow delete: if isAdmin();
    }
    // push notification tokens: each member's own phones (notify/state is server-only)
    match /pushTokens/{name} {
      allow read, write: if isOwner(name);
    }

    match /chat/{msgId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.user == myName()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200;
      allow delete: if staff('auction');
      allow update: if false;
    }
    match /shared/{docId} {
      allow read: if approved() || (docId == 'public');
      allow write: if approved() && docId in ['auction', 'history', 'schedule'];
      allow write: if staff('auction') && docId == 'month';
      allow write: if isAdmin() && docId in ['banner', 'qr', 'announcements', 'coadmins', 'public'];
      allow write: if docId == 'board' && (staff('payments') || staff('auction'));
      allow create: if docId == 'board' && approved()
        && selfBoardKeys(request.resource.data.keys().toSet());
      allow update: if docId == 'board' && approved()
        && selfBoardKeys(request.resource.data.diff(resource.data).affectedKeys());
    }
  }
}
