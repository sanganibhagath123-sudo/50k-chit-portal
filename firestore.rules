rules_version = '2';

// =====================================================================
// 50K CHIT PORTAL – Firestore Security Rules
// Paste this whole file into: Firebase Console → Firestore Database → Rules → Publish
//
// Who is who:
//   admins/{uid}      → Bhagath (created by hand in the Console, see SETUP guide)
//   users/{uid}       → { username }   (links a login to a member name)
//   members/{name}    → { uid, username, status: pending|approved|rejected, role }
//   shared/coadmins   → { map: { name: { payments, auction, members } } }
// Private per member: profiles/{name}, payments/{name}, passbook/{name}, surety/{name}
// Shared for the group: shared/{auction|history|month|schedule|banner|qr|announcements|board|public}
// Live chat: chat/{messageId}
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function approved() {
      return hasProfile() &&
        get(/databases/$(database)/documents/members/$(myName())).data.status == 'approved';
    }
    function coPerm(perm) {
      return approved() &&
        exists(/databases/$(database)/documents/shared/coadmins) &&
        get(/databases/$(database)/documents/shared/coadmins).data.map
          .get(myName(), {}).get(perm, false) == true;
    }
    // Bhagath, or a co-admin who was given this permission
    function staff(perm) { return isAdmin() || coPerm(perm); }
    function isOwner(name) { return hasProfile() && myName() == name; }

    // A member may only change their OWN board entries, and only to "submitted"
    function selfBoardKeys(changed) {
      return changed.hasOnly(['pay_' + myName(), 'sr_' + myName()])
        && (!(('pay_' + myName()) in changed) || request.resource.data['pay_' + myName()] == 'submitted')
        && (!(('sr_' + myName()) in changed) || request.resource.data['sr_' + myName()] == 'submitted');
    }

    // ---------- admins: read-only from the app ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;            // only via Firebase Console
    }

    // ---------- users/{uid} → username link ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username'])
        && get(/databases/$(database)/documents/members/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- members (names + approval status; no passwords) ----------
    match /members/{name} {
      allow read: if signedIn();
      // Self sign-up: always starts as "pending"
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == name
        && request.resource.data.status == 'pending'
        && (request.resource.data.role == 'member'
            || (request.resource.data.role == 'organizer' && name == 'bhagath'));
      // Approve / reject: Bhagath or co-admin with "members" permission.
      // Bhagath can also approve his own record on first login.
      allow update: if isAdmin()
        || (staff('members')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approvedAt', 'updatedAt'])
            && resource.data.role != 'organizer');
      allow delete: if isAdmin();
    }

    // ---------- private: profile (name, phone, UPI, nominee, email) ----------
    match /profiles/{name} {
      allow read: if isOwner(name) || isAdmin() || staff('members');
      allow write: if isOwner(name) || isAdmin();
    }

    // ---------- private: this month's payment ----------
    match /payments/{name} {
      allow read: if isOwner(name) || staff('payments');
      // Member can only say "I have paid" (submitted), never "verified"
      allow create, update: if (isOwner(name) && approved()
            && request.resource.data.status == 'submitted'
            && (resource == null || resource.data.status != 'verified'))
        || (staff('payments') && (isAdmin() || name != myName()));
      allow delete: if staff('payments') || staff('auction');
    }

    // ---------- private: month-wise passbook (written when verified) ----------
    match /passbook/{name} {
      allow read: if isOwner(name) || staff('payments');
      allow write: if staff('payments') && (isAdmin() || name != myName());
    }

    // ---------- private: surety (guarantor) ----------
    match /surety/{name} {
      allow read: if isOwner(name) || isAdmin();
      allow create, update: if (isOwner(name) && approved()
            && request.resource.data.status == 'submitted'
            && (resource == null || !(resource.data.status in ['verified', 'released'])))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- live chat messages ----------
    match /chat/{msgId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.user == myName()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200;
      allow delete: if staff('auction');
      allow update: if false;
    }

    // ---------- shared group documents ----------
    match /shared/{docId} {
      allow read: if approved() || (docId == 'public');

      // Live auction state, results, next date: any approved member's app updates these
      allow write: if approved() && docId in ['auction', 'history', 'schedule'];

      // Month counter: Bhagath / co-admin (auction)
      allow write: if staff('auction') && docId == 'month';

      // Banner, QR, announcements, co-admin list, public contact: Bhagath only
      allow write: if isAdmin() && docId in ['banner', 'qr', 'announcements', 'coadmins', 'public'];

      // Status board (who paid / surety status) – shown to everyone, no amounts
      allow write: if docId == 'board' && (staff('payments') || staff('auction'));
      allow create: if docId == 'board' && approved()
        && selfBoardKeys(request.resource.data.keys().toSet());
      allow update: if docId == 'board' && approved()
        && selfBoardKeys(request.resource.data.diff(resource.data).affectedKeys());
    }

  }
}
